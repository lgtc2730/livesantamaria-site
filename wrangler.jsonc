{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "livesantamaria-public",

  "compatibility_date": "2026-07-16",

  "pages_build_output_dir": ".",

  "services": [
    {
      "binding": "MARINE_CONTROL",
      "service": "livesantamaria-control-api"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "MARINE_CACHE",
      "id": "be8898d38b8747808a3514df1fe25ba5"
    }
  ],

  "d1_databases": [
    {
      "binding": "LVSM_AUDIENCE",
      "database_name": "LVSM_AUDIENCE",
      "database_id": "485db11f-d955-494b-a0b9-beb8eea28f44",
      "migrations_dir": "database/migrations"
    }
  ]
}
